{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "VAULT_PATH='/path/to/your/vault' bash \"$HOME/.claude/hooks/vault-check.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "VAULT_PATH='/path/to/your/vault' bash \"$HOME/.claude/hooks/checkpoint.sh\""
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "VAULT_PATH='/path/to/your/vault' node \"$HOME/.claude/hooks/stop-reminder.js\""
          }
        ]
      }
    ],

    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "VAULT_PATH='/path/to/your/vault' bash \"$HOME/.claude/hooks/post-vault-lint.sh\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "VAULT_PATH='/path/to/your/vault' bash \"$HOME/.claude/hooks/precompact.sh\""
          }
        ]
      }
    ]
  }
}
